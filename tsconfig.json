{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@inspector/protocol": ["packages/protocol/src/index.ts"],
      "@inspector/store-sqlite": ["packages/store-sqlite/src/index.ts"],
      "@inspector/artifact-store": ["packages/artifact-store/src/index.ts"],
      "@inspector/adapter-sdk": ["packages/adapter-sdk/src/index.ts"],
      "@inspector/adapter-fake": ["packages/adapter-fake/src/index.ts"],
      "@inspector/core": ["packages/core/src/index.ts"],
      "@inspector/cli": ["packages/cli/src/index.ts"],
      "@inspector/finding": ["packages/finding/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "**/dist/**"]
}
